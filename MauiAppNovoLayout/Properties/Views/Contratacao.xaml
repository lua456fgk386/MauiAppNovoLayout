<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppNovoLayout.Views.Contratacao"
             Title="  Contratacao"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        

        
        <Label 
            
            Text="Sobre"
            FontFamily="CaveatRegular"
            FontSize="50"
            TextColor="{StaticResource Primary}"
            />


        <Label Text="Nome do desenvolvedor:" 
            FontFamily="CaveatRegular"
            FontSize="50"
            TextColor="{StaticResource Primary}"/>
        <Entry x:Name="txt_digiteseunome" Placeholder="nome: "
               FontFamily="CaveatRegular"
               TextColor="{StaticResource Gray500}"/>

        <Label 
            
            Text="ano de desenvolvimento"
            FontFamily="CaveatRegular"
            FontSize="50"
            TextColor="{StaticResource Primary}"
            />
        <Entry x:Name="txt_anodedesenvolvimento" Placeholder="ano: "
       FontFamily="CaveatRegular"
       TextColor="{StaticResource Gray500}"/>

              

        <Frame Padding="10">

         

            <VerticalStackLayout>

               

                <Grid RowDefinitions="Auto, Auto"
                     ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Idade:"/>

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_idade}"/>
                    
                    
                    
                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_idade"
                             Minimum="18"
                             Maximum="100"
                             Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Anos de Ex:"/>

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_anosdeex}"/>

                 


                    <Stepper Grid.Row="1" Grid.Column="2"
                           x:Name="stp_anosdeex"
                           Minimum="1"
                           Maximum="100"
                           Increment="1"/>

                </Grid>


                <Label Text="Escolha uma Vaga"/>

                <Picker x:Name="pck_vaga"
                            Title="Selecione uma Vaga"/>

                

                <Button Text="Avançar"/>
            </VerticalStackLayout>
            
        </Frame>
    </VerticalStackLayout>
</ContentPage>